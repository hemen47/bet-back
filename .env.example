# --- App -------------------------------------------------------------
NODE_ENV=development
PORT=47311
# Comma-separated origins of the Next.js frontend
CORS_ORIGINS=http://localhost:47310
# true when running behind a reverse proxy (nginx / Caddy / Traefik)
TRUST_PROXY=false

# --- MongoDB (must be a replica set, e.g. Atlas: transactions are used) --
MONGODB_URI=

# --- Telegram ----------------------------------------------------------
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# webhook (production) | polling (local dev) | off
TELEGRAM_BOT_MODE=off
# Public HTTPS base URL of this API (webhook mode): Telegram posts to <url>/telegram/webhook
TELEGRAM_WEBHOOK_URL=
# 16-256 chars of A-Z a-z 0-9 _ - (webhook mode)
TELEGRAM_WEBHOOK_SECRET=
# HTTPS URL of the Next.js Mini App, opened by the bot's "Play" button
MINI_APP_URL=
# Max age in seconds of Telegram initData accepted at sign-in
TELEGRAM_INIT_DATA_MAX_AGE=86400

# --- Auth --------------------------------------------------------------
# At least 32 chars: openssl rand -hex 32
JWT_SECRET=
JWT_TTL=12h

# --- Economy -----------------------------------------------------------
STARTING_BALANCE=1000
DAILY_REWARD_AMOUNT=100
